# Server-only — Pinata JWT for /api/upload (pinJSONToIPFS scope)
PINATA_JWT=

# Optional — dedicated gateway tried before public ones (keep trailing /ipfs/)
NEXT_PUBLIC_IPFS_GATEWAY=

# Optional — 677 (mainnet, default) or 968 (testnet registry for local dev)
NEXT_PUBLIC_REGISTRY_CHAIN=677

# Optional — defaults to https://$VERCEL_PROJECT_PRODUCTION_URL
NEXT_PUBLIC_SITE_URL=

# Optional — panel id for the hero "See a live panel" button
NEXT_PUBLIC_FEATURED_PANEL_ID=

# Optional — Upstash Redis (Vercel Marketplace) enables /api/opens
KV_REST_API_URL=
KV_REST_API_TOKEN=
